{
  "name": "yq.rs",
  "version": "0.1.2",
  "description": "YAML and JSON queries with yq-compatible semantics, powered by Rust and WebAssembly",
  "type": "module",
  "main": "./dist/inline.js",
  "types": "./dist/inline.d.ts",
  "exports": {
    ".": {
      "types": "./dist/inline.d.ts",
      "import": "./dist/inline.js"
    },
    "./inline": {
      "types": "./dist/inline.d.ts",
      "import": "./dist/inline.js"
    },
    "./loader": {
      "types": "./dist/yq.d.ts",
      "import": "./dist/yq.js"
    },
    "./yq.wasm": "./dist/yq.wasm",
    "./package.json": "./package.json",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.mjs"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "crates/yq-core/licenses/"
  ],
  "scripts": {
    "build": "node js/build.mjs",
    "typecheck": "tsc --project js/tsconfig.json --noEmit",
    "test": "node js/package-test.mjs",
    "smoke:node": "node js/package-test.mjs node",
    "smoke:bun": "node js/package-test.mjs bun",
    "prepack": "npm run build",
    "test:cli": "node js/cli-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taras/yq.rs.git"
  },
  "homepage": "https://github.com/taras/yq.rs#readme",
  "bugs": "https://github.com/taras/yq.rs/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8",
    "typescript": "5.9.3"
  },
  "bin": {
    "yq": "dist/cli.mjs"
  },
  "optionalDependencies": {
    "yq.rs-darwin-arm64": "0.1.2",
    "yq.rs-darwin-x64": "0.1.2",
    "yq.rs-linux-arm64-gnu": "0.1.2",
    "yq.rs-linux-x64-gnu": "0.1.2",
    "yq.rs-linux-x64-musl": "0.1.2",
    "yq.rs-win32-x64": "0.1.2",
    "yq.rs-darwin-arm64-napi": "0.1.2",
    "yq.rs-darwin-x64-napi": "0.1.2",
    "yq.rs-linux-x64-gnu-napi": "0.1.2",
    "yq.rs-linux-arm64-gnu-napi": "0.1.2",
    "yq.rs-linux-x64-musl-napi": "0.1.2",
    "yq.rs-win32-x64-napi": "0.1.2"
  },
  "napi": {
    "binaryName": "yq",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  }
}
