package yqlib

import (
	"encoding/json"
	"os"
	"testing"
)

type dumpedScenario struct {
	Group                string            `json:"group"`
	Description          string            `json:"description"`
	Subdescription       string            `json:"subdescription,omitempty"`
	Document             string            `json:"document"`
	Document2            string            `json:"document2,omitempty"`
	Expression           string            `json:"expression"`
	Expected             []string          `json:"expected"`
	ExpectedError        string            `json:"expectedError,omitempty"`
	EnvironmentVariables map[string]string `json:"environmentVariables,omitempty"`
	SkipDoc              bool              `json:"skipDoc,omitempty"`
	RequiresFormat       string            `json:"requiresFormat,omitempty"`
	SkipForGoccy         bool              `json:"skipForGoccy,omitempty"`
}

func dumpGroup(out *[]dumpedScenario, group string, scenarios []expressionScenario) {
	for _, s := range scenarios {
		// Go marshals nil slices as null; the fixture promises arrays.
		expected := s.expected
		if expected == nil {
			expected = []string{}
		}
		*out = append(*out, dumpedScenario{
			Group: group, Description: s.description, Subdescription: s.subdescription,
			Document: s.document, Document2: s.document2, Expression: s.expression,
			Expected: expected, ExpectedError: s.expectedError,
			EnvironmentVariables: s.environmentVariables, SkipDoc: s.skipDoc,
			RequiresFormat: s.requiresFormat, SkipForGoccy: s.skipForGoccy,
		})
	}
}

func TestDumpScenarios(t *testing.T) {
	var all []dumpedScenario
	//DUMP_GROUPS
	data, err := json.MarshalIndent(all, "", "  ")
	if err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(os.Getenv("SCENARIO_DUMP"), data, 0o644); err != nil {
		t.Fatal(err)
	}
}
